# Self-Healing Code-Generation Agent
# Copy to .env and fill in values

# Required: OpenRouter API key for multi-model routing
OPENROUTER_API_KEY=

# Optional: direct provider keys for comparison
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: observability
BRAINTRUST_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=self-healing-agent

# Optional: OTel collector endpoint (default: localhost:7404)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:7404
